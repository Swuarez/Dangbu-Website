# ============================================================
# Dangbu Unlimited Samgyupsal & Buffet — environment template
# Copy this file to ".env" and fill in your Supabase project
# values. NEVER commit a real .env — it is git-ignored.
#
# Both values are PUBLIC client credentials (Project Settings →
# API → "anon public" key). They are safe to ship in the browser
# because every table is protected by Row Level Security.
# The SERVICE ROLE key must never be used here.
# ============================================================

# https://your-project-ref.supabase.co  (Supabase → Project Settings → API Keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# sb_publishable_... (the PUBLISHABLE key, NOT the secret/service role key)
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# SECURITY: never commit real credentials to git. If a real publishable key
# was ever committed, rotate it: Supabase → Project Settings → API Keys →
# rotate, then update .env and redeploy.

# ------------------------------------------------------------
# Optional: leave both empty to run the site fully offline —
# reservations then use the built-in localStorage adapter and
# the staff dashboard shows a setup notice instead.
# ------------------------------------------------------------
