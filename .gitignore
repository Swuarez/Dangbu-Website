# ============================================================
# Dangbu Unlimited Samgyupsal & Buffet — .gitignore
# ============================================================

# ---------- Dependencies ----------
node_modules/
.pnp/
.pnp.*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ---------- Build output ----------
dist/
dist-ssr/
build/
.vite/
.cache/
*.tsbuildinfo
stats.html

# ---------- Test / coverage ----------
coverage/
*.lcov
.nyc_output/

# ---------- Environment & secrets (NEVER commit) ----------
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.pfx
secrets.*
service-account*.json

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- OS junk ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- Editors & IDEs ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ---------- Deployment platforms ----------
.vercel/
.netlify/

# ---------- Lint / tool caches ----------
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/

